# ─────────────────────────────────────────────────────────────
#  Folio — variables d'environnement
#  Local : copier ce fichier en « .env ».
#  Vercel : saisir ces variables dans Project → Settings → Environment Variables
#           (voir DEPLOIEMENT.md). Ne jamais committer de vrais secrets.
# ─────────────────────────────────────────────────────────────

# ── Base de données PostgreSQL (Neon) ────────────────────────
# Neon → votre projet → Connect : copiez les deux chaînes de connexion.
# DATABASE_URL : connexion « pooled » (l'hôte contient « -pooler »), utilisée par le site.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL : connexion directe (sans « -pooler »), utilisée pour créer / mettre à jour les tables.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Sécurité ─────────────────────────────────────────────────
# Clé de signature des sessions, au moins 32 caractères aléatoires.
# Générer avec : openssl rand -base64 48
AUTH_SECRET=""

# ── Site ─────────────────────────────────────────────────────
# URL publique, sans « / » final (liens des emails, QR code du CV, sitemap). Vide en local.
APP_URL="https://mon-domaine.com"

# ── Compte super admin (créé par « npm run db:seed ») ────────
ADMIN_EMAIL="admin@mon-domaine.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur"

# ── Stockage des fichiers : Cloudflare R2 ────────────────────
# Obligatoire sur Vercel (son disque n'est pas conservé). Vide en local = dossier uploads/.
# Cloudflare → R2 → votre bucket. Identifiant de compte : visible dans l'URL du tableau de bord.
R2_ACCOUNT_ID=""
R2_BUCKET="folio-media"
# R2 → Manage API tokens → Create API token (permission « Object Read & Write » sur le bucket)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# URL publique du bucket : domaine personnalisé (ex. https://media.mon-domaine.com) ou https://pub-xxxx.r2.dev
R2_PUBLIC_URL=""

# ── Emails (SMTP) ────────────────────────────────────────────
# Notifications de messages et « mot de passe oublié ». Brevo, Resend, Mailgun…
# SMTP_HOST vide = emails affichés dans les logs au lieu d'être envoyés.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Folio <no-reply@mon-domaine.com>"

# ── Anti-spam Cloudflare Turnstile (optionnel, recommandé) ───
# Cloudflare → Turnstile → Add widget. Vide = désactivé.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
