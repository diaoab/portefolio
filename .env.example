# ─────────────────────────────────────────────────────────────
#  Folio — variables d'environnement
#  Copier ce fichier en « .env » puis remplir les valeurs.
#  Ne jamais committer le fichier .env (il contient des secrets).
# ─────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────
# SQLite (fichier créé dans prisma/). Parfait sur un VPS.
DATABASE_URL="file:./data.db"

# ── Sécurité ─────────────────────────────────────────────────
# Clé de signature des sessions : chaîne aléatoire d'au moins 32 caractères.
# Générer avec : openssl rand -base64 48
AUTH_SECRET=""

# ── Site ─────────────────────────────────────────────────────
# URL publique, sans « / » final (liens des emails, QR code du CV, sitemap, partages).
APP_URL="https://mon-domaine.com"

# ── Compte super admin ───────────────────────────────────────
# Créé une seule fois par « npm run setup ». Changez le mot de passe après la 1re connexion.
ADMIN_EMAIL="admin@mon-domaine.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrateur"

# ── Emails (SMTP) ────────────────────────────────────────────
# Notifications de messages et « mot de passe oublié ».
# Fonctionne avec Brevo, Resend, Mailgun, OVH, Gmail… (voir les identifiants SMTP de votre fournisseur).
# Laisser SMTP_HOST vide = emails affichés dans les logs du serveur au lieu d'être envoyés.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Expéditeur : doit être une adresse de votre domaine validée chez le fournisseur.
MAIL_FROM="Folio <no-reply@mon-domaine.com>"

# ── Anti-spam (optionnel, recommandé) ────────────────────────
# Captcha invisible Cloudflare Turnstile sur le formulaire de contact.
# Clés gratuites : https://dash.cloudflare.com → Turnstile. Vide = désactivé.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
